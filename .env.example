# =====================================================================
#  CANVAS HUB – inställningar
#  På Vercel fyller du i dessa under Settings → Environment Variables.
#  Lokalt: kopiera filen till .env.local och fyll i där.
#  Skriv ALDRIG riktiga nycklar i den här filen.
# =====================================================================

# Canvas → Konto → Inställningar → + Ny åtkomsttoken
CANVAS_TOKEN=

# platform.openai.com → API keys → Create new secret key
OPENAI_API_KEY=

# Ett lösenord du hittar på (minst 8 tecken). Används för att logga in i appen.
APP_PASSWORD=

# Sätts automatiskt när du kopplar Neon i Vercel. Lokalt: kopiera från Neon → Connect.
DATABASE_URL=

# Valfria
CANVAS_BASE_URL=https://canvas.kth.se
AI_MODEL=gpt-5.4-mini
